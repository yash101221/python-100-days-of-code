rock = """
    _______
---'   ____)
      (_____)
      (_____)
      (____)
---.__(___)
"""

paper = """
     _______
---'    ____)____
           ______)
          _______)
         _______)
---.__________)
"""

scissors = """
    _______
---'   ____)____
          ______)
       __________)
      (____)
---.__(___)
"""

print("What do you choose? Type 0 for Rock, 1 for paper and, 2 for scissors")
user_input = int(input())
if user_input == 0:
    print("User Input: Rock\n" + rock)
elif user_input == 1:
    print("User Input: Paper\n"+ paper)
elif user_input == 2:
    print("User Input: Scissors\n"+ scissors)
else:
    print("Invalid choice. Please type 0, 1, or 2.")
    exit()

import random

computer_choice = random.randint(0, 2)
if computer_choice == 0:
    print("Computer Input: Rock\n" + rock)
elif computer_choice == 1:
    print("Computer Input: Paper\n"+ paper)
elif computer_choice == 2:
    print("Computer Input: Scissors\n"+ scissors)

if user_input == computer_choice:
    print("It's a Draw")
elif (user_input == 0 and computer_choice == 2) or \
     (user_input == 1 and computer_choice == 0) or \
     (user_input == 2 and computer_choice == 1):
    print("You Win!")
else:
    print("You Lose!")


